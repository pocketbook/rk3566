set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_VERSION 1.0)
set(CMAKE_SYSTEM_PROCESSOR armv8l)
set(BUILD_SHARED_LIBS ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)

get_filename_component(CMAKE_TOOLCHAIN_FILE_DIR ${CMAKE_CURRENT_LIST_FILE} DIRECTORY)
get_filename_component(SDK_ROOT_ "${CMAKE_TOOLCHAIN_FILE_DIR}/../.." ABSOLUTE)
set(SDK_ROOT "${SDK_ROOT_}" CACHE PATH "" FORCE)
set(SDK_TRIPLET "arm-buildroot-linux-gnueabihf")
set(SDK_SYSROOT "${SDK_ROOT}/usr/${SDK_TRIPLET}/sysroot")

set(CMAKE_SYSROOT "${SDK_SYSROOT}")

set(CMAKE_INSTALL_PREFIX "${SDK_SYSROOT}/usr/local" CACHE PATH "Installation Prefix")
set(CMAKE_PREFIX_PATH "${SDK_SYSROOT}")

list(PREPEND CMAKE_FIND_ROOT_PATH "${SDK_SYSROOT}")
list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)

set(FREETYPE_INCLUDE_DIRS "${SDK_SYSROOT}/usr/include/freetype2")

message(STATUS "CMAKE_MODULE_PATH=${CMAKE_MODULE_PATH}")
message(STATUS "CMAKE_FIND_ROOT_PATH=${CMAKE_FIND_ROOT_PATH}")
message(STATUS "CMAKE_INSTALL_PREFIX=${CMAKE_INSTALL_PREFIX}")
message(STATUS "CMAKE_INCLUDE_PATH=${CMAKE_INCLUDE_PATH}")
message(STATUS "CMAKE_LIBRARY_PATH=${CMAKE_LIBRARY_PATH}")

set(CMAKE_BUILD_TYPE Release CACHE STRING "Debug|Release|RelWithDebInfo|MinSizeRel")

set(CMAKE_C_COMPILER "${SDK_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${SDK_ROOT}/bin/clang++")
set(CMAKE_ASM_COMPILER "${SDK_ROOT}/bin/arm-buildroot-linux-gnueabihf-gcc")
set(CMAKE_STRIP "${SDK_ROOT}/bin/arm-buildroot-linux-gnueabihf-strip")

set(CMAKE_C_COMPILER_TARGET ${SDK_TRIPLET})
set(CMAKE_CXX_COMPILER_TARGET ${SDK_TRIPLET})

set(CMAKE_C_FLAGS "-mcpu=cortex-a55 -mfloat-abi=hard -fsigned-char -Wno-return-type -pipe -fomit-frame-pointer -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 " CACHE STRING "" FORCE)
set(CMAKE_C_FLAGS_RELEASE "-DNDEBUG -O2 -g0 -D_FORTIFY_SOURCE=1 " CACHE STRING "" FORCE)
set(CMAKE_C_FLAGS_DEBUG "-DDEBUG -O0 -g " CACHE STRING "" FORCE)

set(CMAKE_CXX_FLAGS "-mcpu=cortex-a55 -mfloat-abi=hard -fsigned-char -Wno-return-type -pipe -fomit-frame-pointer -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 " CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "-DNDEBUG -O2 -g0 -D_FORTIFY_SOURCE=1 " CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_DEBUG "-DDEBUG -O0 -g " CACHE STRING "" FORCE)

add_definitions(-DPLATFORM_FC)
set(PB_PLATFORM "ARM" CACHE STRING "ARM|PC Readonly!")

set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH ON)
set(ENV{PKG_CONFIG_SYSROOT_DIR} ${CMAKE_SYSROOT})
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSTEM_INCLUDE_PATH} "${CMAKE_SYSROOT}/usr/include")
set(ENV{PKG_CONFIG_SYSTEM_LIBRARY_PATH} "${CMAKE_SYSROOT}/usr/lib")

set(ENV{LD_LIBRARY_PATH} ${SDK_SYSROOT}/usr/lib)

list(APPEND PB_LINK_DIRECTORIES "${SDK_SYSROOT}/usr/lib")
list(APPEND PB_LINK_DIRECTORIES "${SDK_SYSROOT}/usr/local/lib")
list(APPEND PB_INCLUDE_DIRECTORIES "${SDK_SYSROOT}/usr/include")

set(PBRES "${SDK_ROOT}/usr/bin/pbres")

if($ENV{CUT_SOURCE_LOCATION_PATHS})
    get_filename_component(CMAKE_SOURCE_DIR_NAME ${CMAKE_SOURCE_DIR} NAME)
    add_compile_options(-ffile-prefix-map=${CMAKE_SOURCE_DIR}=${CMAKE_SOURCE_DIR_NAME})
endif()
