set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(BUILD_SHARED_LIBS ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)

get_filename_component(CMAKE_TOOLCHAIN_FILE_DIR ${CMAKE_CURRENT_LIST_FILE} DIRECTORY)
get_filename_component(SDK_ROOT_ "${CMAKE_TOOLCHAIN_FILE_DIR}/../.." ABSOLUTE)
set(SDK_ROOT "${SDK_ROOT_}" CACHE PATH "" FORCE)
message(STATUS "SDK_ROOT=${SDK_ROOT}")

set(CMAKE_C_FLAGS "-fPIC")
set(CMAKE_CXX_FLAGS_RELEASE "-DNDEBUG -O2 -pipe -fomit-frame-pointer -fPIC " CACHE STRING "" FORCE)
set(CMAKE_C_FLAGS_RELEASE "-DNDEBUG -O2 -pipe -fomit-frame-pointer -fPIC " CACHE STRING "" FORCE)
set(CMAKE_EXE_LINKER_FLAGS_RELEASE " -s" CACHE STRING "" FORCE)
set(CMAKE_SHARED_LINKER_FLAGS_RELEASE "-s" CACHE STRING "" FORCE)

set(CMAKE_LINKER_FLAGS "-z,defs" CACHE STRING "" FORCE)

SET(CMAKE_C_COMPILER /usr/bin/clang)
SET(CMAKE_CXX_COMPILER /usr/bin/clang++)
SET(CMAKE_ASM_COMPILER /usr/bin/clang)

set(CMAKE_CXX_FLAGS_DEBUG "-ggdb -O0 -pipe -fno-omit-frame-pointer -fPIC" CACHE STRING "" FORCE)
set(CMAKE_C_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG}" CACHE STRING "" FORCE)
set(CMAKE_EXE_LINKER_FLAGS_DEBUG "" CACHE STRING "" FORCE)
set(CMAKE_SHARED_LINKER_FLAGS_DEBUG "" CACHE STRING "" FORCE)

set(CMAKE_INSTALL_PREFIX "${SDK_ROOT}/usr/local" CACHE PATH "Installation Prefix")

list(APPEND CMAKE_FIND_ROOT_PATH "${SDK_ROOT}/usr/local")
list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)

list(PREPEND CMAKE_LIBRARY_PATH "${SDK_ROOT}/usr/local/lib")
list(REMOVE_DUPLICATES CMAKE_LIBRARY_PATH)

list(PREPEND CMAKE_INCLUDE_PATH "${SDK_ROOT}/usr/local/include")
list(REMOVE_DUPLICATES CMAKE_INCLUDE_PATH)

message(STATUS "CMAKE_MODULE_PATH=${CMAKE_MODULE_PATH}")
message(STATUS "CMAKE_FIND_ROOT_PATH=${CMAKE_FIND_ROOT_PATH}")
message(STATUS "CMAKE_INSTALL_PREFIX=${CMAKE_INSTALL_PREFIX}")
message(STATUS "CMAKE_INCLUDE_PATH=${CMAKE_INCLUDE_PATH}")
message(STATUS "CMAKE_LIBRARY_PATH=${CMAKE_LIBRARY_PATH}")

add_definitions(-DEMULATOR -DPLATFORM_NX)

set(PB_PLATFORM "PC" CACHE STRING  "ARM|PC Readonly!") 
set(PBRES "${SDK_ROOT}/usr/bin/pbres")
set(QT_QMAKE_EXECUTABLE "${SDK_ROOT}/usr/local/qt6/bin/qmake")

