	// 	monitor_sec = <5>;
	// 	virtual_power = <0>;
	// };
};

&i2c1 {
	status = "okay";
    clock-frequency = <400000>;

	ft5446: focaltech@38 {
		status = "okay";
		compatible = "focaltech,ft5446";
		reg = <0x38>;
		pinctrl-names = "default";
		pinctrl-0 = <&tp_gpio>;
		vdd-supply = <&vcc_tp>;
		focaltech,reset-gpio = <&gpio0 RK_PC2 GPIO_ACTIVE_HIGH>;
		focaltech,irq-gpio = <&gpio0 RK_PC1 IRQ_TYPE_EDGE_FALLING>;
		focaltech,max-touch-number = <5>;
		focaltech,display-coords =  <0 0 1072 1448>;
		focaltech,have-key = <0>;
		focaltech,key-number = <1>;
		focaltech,key-x-coords = <300>;
		focaltech,key-y-coords = <1300>;
		revert_x = <1>;
		revert_y = <0>;
		xy_exchange = <1>;
		wakeup-source;
	};

	stk83xx: gsensor@f {
		status = "okay";
		compatible = "sensortek,stk83xx";
		reg = <0xf>;
		pinctrl-names = "default";
		pinctrl-0 = <&gsensor_irq_gpio>;
		stk83xx,irq-gpio = <&gpio0 RK_PB5 IRQ_TYPE_LEVEL_LOW>;
		irq_enable = <0>;
		//wakeup-source;
		poll_delay_ms = <30>;
		type = <SENSOR_TYPE_ACCEL>;
		power-off-in-suspend = <0>;
		layout = <5>;
		//1~255
		default_slope_threshold = <2>;
     	};
};

&i2c2 {
	status = "disabled";
	pinctrl-names = "default";
	// pinctrl-0 = <&i2c2m0_xfer>;

    flashlight: aw36518@63 {
        status = "okay";
        compatible = "awinic,aw36518";
        label = "aw36518-flash";
        reg = <0x63>;
        led-max-microamp = <299200>;//torch模式最大电流
        flash-max-microamp = <1122000>;//flash模式最大电流
        flash-max-timeout-us = <1600000>;//falsh最大时间
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
    };
};

&i2c3 {
	status = "okay";
    clock-frequency = <400000>;
    pinctrl-names = "default";
    pinctrl-0 = <&i2c3m1_xfer>;

	sy7636a: sy7636a@62 {
 	        compatible = "silergy,sy7636a-pmic";
 	        reg = <0x62>;
 	        status = "okay";
			pinctrl-names = "default";
 	        pinctrl-0 = <&einkpmic_gpio>;
			/* chipen, pvddctrl, vcomctl, and EINK_VCC_EN_H (gpio0 PC0): factory models
			 * the last as a separate always-on regulator, which can never drop it in suspend. */
			enable-gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>, <&gpio3 RK_PB1 GPIO_ACTIVE_HIGH>, <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>, <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
			pgood-gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
			thermal-zone = "ebcpmic-thermal";
 	        #thermal-sensor-cells = <0>;
			regulators {
 	            compatible = "sy7636a-regulator";
 	            reg_ebcpmic: vcom {
 	                regulator-name = "vcom";
 	                regulator-min-microvolt = <0>;
 	                regulator-max-microvolt = <5000000>;
 	                regulator-boot-on;
 	                regulator-state-mem {
 	                    regulator-off-in-suspend;
 	                };
 	            };
 	        };                                                                                                                               
			sy7636a_thermal: sy7636a_thermal {
 	            compatible = "sy7636a-thermal";
 	        };
	};

};

&i2c4 {
	/* Nothing on it: muxing it (as factory does) keeps gpio2_B1's reset
	 * pull-down off the fitted 2.2K pull-up R1516. */
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m1_xfer>;
};

&i2c5 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5m0_xfer>;
	clock-frequency = <100000>;

	lm3630a: lm3630a@36 {
		status = "okay";
		reg = <0x36>;
		compatible = "ti,lm3630a";
		pinctrl-names = "default";
		pinctrl-0 = <&lm3630a_gpio>;
		led-enable-gpio= <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		enable-gpio = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
		lm3630a-pwm = <&pwm15 0 25000 0>;
		/*	ch1 enable exp = 0x4, ch1 enable linear = 0x14, ch1+ch2 enable exp = 0x6, ch1+ch2 enable linear = 0x1e, ch1+ch2 controled by ch1 in exp mode = 0x5, ch1+ch2 controled by ch1 in linear mode = 0x15 */
		mode = <0x6>;
		/*	max current register setting. see lm3630a spec [ LED_I_OUT = 5 + 0.75 * max_i_chX (mA) ] (unsigned integer value) */
		max_i_ch1 = <1>;
		max_i_ch2 = <2>;
	};

	fusb0: fusb30x@22 {
		compatible = "fcs,fusb302";
		// compatible = "fairchild,fusb302";
		reg = <0x22>;
		pinctrl-names = "default";
		pinctrl-0 = <&fusb0_int>;
		fcs,int_n-gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_LOW>;
		//fcs,int_n_v13-gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		vbus-supply = <&otg_switch>;
		fusb302,role = "ROLE_MODE_DRP";
		fusb302,try_role = "ROLE_MODE_UFP";
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				usbc0_role_sw: endpoint@0 {
					remote-endpoint = <&dwc3_role_switch>;
				};
			};
		};

		// usb_con: connector {
		// 	compatible = "usb-c-connector";
		// 	label = "USB-C";
		// 	data-role = "dual";
		// 	power-role = "dual";
		// 	try-power-role = "sink";
		// 	op-sink-microwatt = <1000000>;
		// 	// sink-pdos =
		// 	// 	<PDO_FIXED(5000, 1000, PDO_FIXED_USB_COMM)>;
		// 	// source-pdos =
		// 	// 	<PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
		// };
	};

   	// usbc0: fusb302@22 {
	// 	compatible = "fcs,fusb302";
	// 	reg = <0x22>;
	// 	interrupt-parent = <&gpio3>;
	// 	interrupts = <RK_PB2 IRQ_TYPE_LEVEL_LOW>;
	// 	pinctrl-names = "default";
	// 	pinctrl-0 = <&fusb0_int>;
	// 	vbus-supply = <&otg_switch>;
	// 	status = "okay";

	// 	ports {
	// 		#address-cells = <1>;
	// 		#size-cells = <0>;

	// 		port@0 {
	// 			reg = <0>;
	// 			usbc0_role_sw: endpoint@0 {
	// 				remote-endpoint = <&dwc3_role_switch>;
	// 			};
	// 		};
	// 	};

	// 	usb_con: connector {
	// 		compatible = "usb-c-connector";
	// 		label = "USB-C";
	// 		data-role = "dual";
	// 		power-role = "dual";
	// 		try-power-role = "sink";
	// 		op-sink-microwatt = <1000000>;
	// 		sink-pdos =
	// 			<PDO_FIXED(5000, 1000, PDO_FIXED_USB_COMM)>;
