};

&spi1{
	status = "disabled";
	pinctrl-0 = <&spi1m1_cs0 &spi1m1_pins>;
	pinctrl-1 = <&spi1m1_cs0 &spi1m1_pins_hs>;
	finger_fp@0{
		compatible = "finger,fpsensor";
		reg = <0x00>;
		spi-max-frequency = <6000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&finger_gpio>;
		irq-gpio = <&gpio0 RK_PB4 IRQ_TYPE_LEVEL_LOW>;
		reset-gpio = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
		// status = "okay";
		status = "disabled";
	};
};

&i2s0_8ch {
	status = "disabled";
};

&i2s1_8ch {
	status = "okay";
	rockchip,clk-trcm = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2s1m0_sclktx
		     &i2s1m0_lrcktx
		     &i2s1m0_sdi0
		     &i2s1m0_sdo0>;
};

&i2s2_2ch {
	status = "okay";
};

&i2s3_2ch {
	status = "disabled";
	#sound-dai-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2s3m1_sclk
		&i2s3m1_lrck
		&i2s3m1_sdi>;
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&video_phy0 {
	status = "disabled";
};

&mpp_srv {
	status = "okay";
};

&nandc0 {
	status = "disabled";
};

&pinctrl {
	finger {
		finger_gpio: finger-gpio {
			rockchip,pins =
					<0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	// wacom {
	// 	wacom_gpio: wacom-gpio {
	// 		rockchip,pins =
	// 				<0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>,
	// 				<0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>,
	// 				<3 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;
	// 	};
    //     emr_gpio: emr-gpio {
    //         rockchip,pins =
    //             <0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>,// EMR_PEN_DETECT
    //             <0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>,
    //             <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
    //     };
	// };

	touchscreen {
	        tp_gpio: tp-gpio {
	            rockchip,pins =
                <0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>,
                <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
	        };
		vcc_tp_en: vcc-tp-en {
			 rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usbtypec {
		fusb0_int: fusb0-int {
			/* INT# is open-drain and the board pull-up R2602 is not fitted */
			rockchip,pins =
				<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	speaker {
		hp_gpio: hp-gpio {
			rockchip,pins =
					<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	pmic {
		pmic_int: pmic_int {
			rockchip,pins =
				<0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		soc_slppin_gpio: soc_slppin_gpio {
			rockchip,pins =
				<0 RK_PA2 RK_FUNC_GPIO &pcfg_output_low_pull_down>;
		};

		soc_slppin_slp: soc_slppin_slp {
			rockchip,pins =
				<0 RK_PA2 1 &pcfg_pull_up>;
		};

		soc_slppin_rst: soc_slppin_rst {
			rockchip,pins =
				<0 RK_PA2 2 &pcfg_pull_none>;
		};
	};

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	seekwcn_boot {
		//<0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>,
		wifi_bt_gpio: wifi-bt-gpio {
			rockchip,pins = 
			<0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>,
			<0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>,
			<0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		wifi_poweren_gpio:wifi-poweren-gpio {
			rockchip,pins = 
			<0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>,
			/* BT_WAKE_HOST_H idles high behind Q6101; a pull-down leaks through its
			 * body diode. Here, not in wifi-bt-gpio, so it applies from boot. */
			<0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	leds {
		leds_gpio: leds-gpio {
			rockchip,pins =
				<3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		lm3630a_gpio:lm3630a-gpio {
			rockchip,pins =
				<0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	keys {
		gpio_keys_gpio: gpio-keys-gpio{
			rockchip,pins =
					<0 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
					<0 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>,
					<0 RK_PD6 RK_FUNC_GPIO &pcfg_pull_up>;
	 	};
	};
    sensors {
        mh248_irq_gpio: mh248-irq-gpio {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

        gsensor_irq_gpio: gsensor-irq-gpio {
            rockchip,pins = <0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>;
        };
    };

	eink_pmic {
        einkpmic_gpio: einkpmic-gpio {
            rockchip,pins =
                <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>,   /* chipen */
                <3 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>,   /* pvddctrl */
                <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>,   /* vcomctl */
                <3 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>,   /* pwrgood */
                <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>,   /* nINT: pull-up R2403 is fitted */
                <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;   /* EINK_VCC_EN_H */
        };
    };
};

&pmu_io_domains {
	status = "okay";
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcc3v3_pmu>;
	vccio1-supply = <&vccio_acodec>;
	vccio2-supply = <&vcca1v8_pmu>;
	vccio3-supply = <&vccio_sd>;
	vccio4-supply = <&vcca1v8_pmu>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_1v8>;	/* VCC_EINK: 1.8V LDO U2408 (RS1562-18) for the EPD interface */
	vccio7-supply = <&vcc_1v8_dvp>;
};

&pwm12 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm12m1_pins>;
	status = "disabled";
};

&pwm15 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm15m0_pins>;
	status = "disabled";
};

&rk_rga {
	status = "okay";
};

&rkisp {
	status = "disabled";
};

&rkisp_mmu {
	status = "disabled";
};

&rkisp_vir0 {
	status = "disabled";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp0_in: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&csidphy0_out>;
		};
	};
};

&rkvdec {
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

&rockchip_suspend {
	status = "okay";

	rockchip,regulator-off-in-mem-lite =
		<&vdd_cpu>, <&vdd_logic>, <&vdd_gpu>, <&vcc_3v3>, <&vdda_0v9>, <&vcc_1v8>, <&vcc_1v8_dvp>,
		<&vccio_acodec>, <&vccio_sd>,  <&dcdc_boost>, <&otg_switch>,
		<&sleep_sta_ctl>;
	rockchip,regulator-on-in-mem-lite =
		<&vcc_ddr>, <&vdda0v9_pmu>, <&vcca1v8_pmu>, <&vcc3v3_pmu>;

	rockchip,regulator-off-in-mem =
		<&vdd_cpu>, <&vdd_logic>, <&vdd_gpu>, <&vcc_3v3>, <&vdda_0v9>, <&vcc_1v8>, <&vcc_1v8_dvp>,
		<&vccio_acodec>, <&vccio_sd>, <&dcdc_boost>, <&otg_switch>,
		<&sleep_sta_ctl>;
	rockchip,regulator-on-in-mem =
		<&vcc_ddr>, <&vdda0v9_pmu>, <&vcca1v8_pmu>, <&vcc3v3_pmu>;

	rockchip,regulator-off-in-mem-ultra =
		<&vdd_logic>, <&vdd_gpu>, <&vcc_ddr>, <&vcc_3v3>, <&vdda_0v9>, <&vcc_1v8>, <&vcc_1v8_dvp>,
		<&vdda0v9_pmu>, <&vcca1v8_pmu>, <&vcc3v3_pmu>, <&vccio_acodec>, <&vccio_sd>,
		<&dcdc_boost>, <&otg_switch>;
	rockchip,regulator-on-in-mem-ultra = <&vdd_cpu>, <&sleep_sta_ctl>;
};

&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&sdhci {
	bus-width = <8>;
	supports-emmc;
	non-removable;
	keep-power-in-suspend;
	max-frequency = <200000000>;
	status = "disabled";
};

&sdmmc0 {
	max-frequency = <150000000>;
	no-sdio;
	no-mmc;
	non-removable;
	keep-power-in-suspend;
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_pwren>;
	status = "okay";
};

/* The board holds SDMMC0_DET_L low (U-Boot needs it for SD boot), so the
 * default pull-up only leaks. */
&sdmmc0_det {
	rockchip,pins = <0 RK_PA4 1 &pcfg_pull_down>;
};

/* SDMMC_PWR switches nothing (card power is VCC_3V3 via R4206 0R), and the
 * boot-time PWREN mux drives it high against the pull-down: park it as GPIO. */
&sdmmc0_pwren {
	rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_down>;
};

&sdmmc1 {
	// max-frequency = <200000000>;
	max-frequency = <150000000>;
	supports-sdio;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk>;
	sd-uhs-sdr104;
	rockchip,default-sample-phase = <90>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

&uart1 {
	status = "okay";
	pinctrl-names = "default";
	/* The chip (U18) has no RTS/CTS: muxing CTSN left it floating */
	pinctrl-0 = <&uart1m0_xfer>;
};

&u2phy0_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usb2phy0 {
	status = "okay";
	// rockchip,usb2phy-bc12;
};

&usbdrd_dwc3 {
	status = "okay";
	usb-role-switch; /* 用于使能 DWC3 驱动注册 USB Role Switch 回调函数 */
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		dwc3_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_role_sw>; /* 关联 FUSB302，实现
			USB 角色切换的功能 */
		};
	};
};

&usbdrd30 {
	status = "okay";
};

&xin32k {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
};

&vdpu {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&vepu {
	status = "okay";
};

&vepu_mmu {
	status = "okay";
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};
